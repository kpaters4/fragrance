{
  "info": {
    "name": "Fragrance API",
    "description": "Tests against the deployed Modal URL for the Fragrance API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://kpaters4--scent-fingerprint-fastapi-app.modal.run",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /info",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/info", "host": ["{{base_url}}"], "path": ["info"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Body has sklearn_version and corpus_size', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('sklearn_version');",
              "    pm.expect(json).to.have.property('corpus_size');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /collection",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/collection", "host": ["{{base_url}}"], "path": ["collection"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Body is an array of scored rows', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "    if (json.length > 0) {",
              "        pm.expect(json[0]).to.have.property('brand');",
              "        pm.expect(json[0]).to.have.property('perfume');",
              "        pm.expect(json[0]).to.have.property('notes');",
              "        pm.expect(json[0]).to.have.property('stats');",
              "        pm.expect(json[0]).to.have.property('matches');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /wishlist",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/wishlist", "host": ["{{base_url}}"], "path": ["wishlist"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Body is an array of scored rows', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "    if (json.length > 0) {",
              "        pm.expect(json[0]).to.have.property('brand');",
              "        pm.expect(json[0]).to.have.property('perfume');",
              "        pm.expect(json[0]).to.have.property('notes');",
              "        pm.expect(json[0]).to.have.property('stats');",
              "        pm.expect(json[0]).to.have.property('matches');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST /analyze (valid)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": [\"sandalwood\", \"iris\", \"leather\", \"musk\"],\n  \"k\": 5\n}"
        },
        "url": { "raw": "{{base_url}}/analyze", "host": ["{{base_url}}"], "path": ["analyze"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has expected shape', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('stats');",
              "    pm.expect(json.stats).to.have.property('note_count');",
              "    pm.expect(json.stats).to.have.property('known_note_count');",
              "    pm.expect(json.stats).to.have.property('avg_rarity');",
              "    pm.expect(json.stats).to.have.property('diversity');",
              "    pm.expect(json.stats).to.have.property('niche_score');",
              "    pm.expect(json.stats.niche_score).to.be.within(0, 100);",
              "    pm.expect(json).to.have.property('matches');",
              "    pm.expect(json.matches).to.be.an('array');",
              "    if (json.matches.length > 0) {",
              "        pm.expect(json.matches[0]).to.have.property('brand');",
              "        pm.expect(json.matches[0]).to.have.property('perfume');",
              "        pm.expect(json.matches[0]).to.have.property('notes');",
              "        pm.expect(json.matches[0]).to.have.property('similarity');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST /analyze (invalid - empty notes)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": [],\n  \"k\": 5\n}"
        },
        "url": { "raw": "{{base_url}}/analyze", "host": ["{{base_url}}"], "path": ["analyze"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST /analyze (invalid - k too large)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": [\"rose\", \"oud\"],\n  \"k\": 999\n}"
        },
        "url": { "raw": "{{base_url}}/analyze", "host": ["{{base_url}}"], "path": ["analyze"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET /clusters",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/clusters", "host": ["{{base_url}}"], "path": ["clusters"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Body has families, fine_clusters, points', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('families').that.is.an('array');",
              "    pm.expect(json).to.have.property('fine_clusters').that.is.an('array');",
              "    pm.expect(json).to.have.property('points').that.is.an('array');",
              "    if (json.families.length > 0) {",
              "        pm.expect(json.families[0]).to.have.property('id');",
              "        pm.expect(json.families[0]).to.have.property('label');",
              "    }",
              "    if (json.points.length > 0) {",
              "        pm.expect(json.points[0]).to.have.property('x');",
              "        pm.expect(json.points[0]).to.have.property('y');",
              "        pm.expect(json.points[0]).to.have.property('fine');",
              "        pm.expect(json.points[0]).to.have.property('family');",
              "        pm.expect(json.points[0]).to.have.property('brand');",
              "        pm.expect(json.points[0]).to.have.property('perfume');",
              "        pm.expect(json.points[0]).to.have.property('notes');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
